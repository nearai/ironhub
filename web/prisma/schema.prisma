generator client {
  provider = "prisma-client"
  output   = "../lib/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id
  name                 String
  email                String                @unique
  emailVerified        Boolean               @default(false) @map("email_verified")
  image                String?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  accounts             Account[]
  agentInstallations   AgentInstallation[]
  installIntentRecords InstallIntentRecord[]
  invitations          Invitation[]
  members              Member[]
  nearAccounts         NearAccount[]
  privateArtifacts     PrivateArtifact[]
  relayedTransactions  RelayedTransaction[]
  sessions             Session[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  activeOrganizationId String?  @map("active_organization_id")
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model NearAccount {
  id        String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String   @map("account_id")
  network   String
  publicKey String   @map("public_key")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([accountId, network])
  @@index([userId])
  @@map("near_account")
}

model RelayedTransaction {
  id         String    @id
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  txHash     String    @map("tx_hash")
  senderId   String    @map("sender_id")
  receiverId String    @map("receiver_id")
  network    String
  status     String
  gasUsed    String?   @map("gas_used")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@unique([txHash])
  @@index([userId])
  @@map("relayed_transaction")
}

model RelayerKey {
  id                  String    @id
  accountId           String    @map("account_id")
  encryptedPrivateKey String    @map("encrypted_private_key")
  iv                  String
  publicKey           String    @map("public_key")
  network             String
  createdAt           DateTime  @default(now()) @map("created_at")
  lastUsedAt          DateTime? @map("last_used_at")

  @@unique([network])
  @@map("relayer_key")
}

model AgentInstallation {
  id                   String                @id
  userId               String                @map("user_id")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                String
  agentUrl             String                @map("agent_url")
  encryptedSharedKey   String                @map("encrypted_shared_key")
  iv                   String
  authTag              String                @map("auth_tag")
  keyFingerprint       String                @map("key_fingerprint")
  isDefault            Boolean               @default(false) @map("is_default")
  verifiedAt           DateTime?             @map("verified_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  installIntentRecords InstallIntentRecord[]

  @@unique([userId, agentUrl])
  @@index([userId])
  @@map("agent_installation")
}

model InstallIntentRecord {
  id                  String            @id
  userId              String            @map("user_id")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentInstallationId String            @map("agent_installation_id")
  agentInstallation   AgentInstallation @relation(fields: [agentInstallationId], references: [id], onDelete: Cascade)
  marketplaceSlug     String            @map("marketplace_slug")
  marketplaceVersion  String            @map("marketplace_version")
  nonceHash           String            @map("nonce_hash")
  issuedAt            DateTime          @default(now()) @map("issued_at")
  expiresAt           DateTime          @map("expires_at")
  redirectUrl         String            @map("redirect_url")
  status              String

  @@unique([nonceHash])
  @@index([userId])
  @@index([agentInstallationId])
  @@map("install_intent_record")
}

model Organization {
  id               String            @id
  name             String
  slug             String            @unique
  logo             String?
  metadata         String?
  createdAt        DateTime          @map("created_at")
  members          Member[]
  invitations      Invitation[]
  privateArtifacts PrivateArtifact[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @map("created_at")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  inviterId      String       @map("inviter_id")
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model PrivateArtifact {
  id                  String                   @id
  organizationId      String                   @map("organization_id")
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById         String?                  @map("created_by_id")
  createdBy           User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  content             PrivateArtifactContent[]
  assets              PrivateArtifactAsset[]
  /// The members this artifact holds, when it is a loadout. Empty for every
  /// other type, and for a loadout that is still an empty draft.
  members             LoadoutMember[]          @relation("LoadoutMembers")
  /// The loadout member rows that point at this artifact. Non-empty means
  /// some loadout lists it, which is what makes it undeletable.
  memberships         LoadoutMember[]          @relation("LoadoutMemberArtifact")
  type                String
  name                String
  title               String
  version             String
  visibility          String                   @default("private")
  status              String                   @default("draft")
  /// The value `version` held the moment `status` became `published`, and
  /// null whenever the artifact is a draft. It exists so the hub can tell
  /// "this is the version an agent may already have installed" from "the
  /// author has bumped since"; the content freeze releases only on the
  /// latter. A version alone cannot answer that -- it is mutable, so it
  /// carries no record of what it used to be.
  publishedVersion    String?                  @map("published_version")
  /// The upstream catalog release a loadout's members were last verified
  /// against. Meaningful only for `type = "loadout"` -- nothing else has
  /// members to verify -- and null means never verified, which is not the
  /// same as verified against nothing. A blank would otherwise read as a
  /// clean bill of health, so a loadout the poll has not reached yet, or one
  /// read for the first time after a deploy, re-verifies instead of trusting
  /// it.
  ///
  /// This is a column rather than process memory because the poll that marks
  /// a loadout and the read that acts on the mark are different processes in
  /// a serverless deployment. A mark held in memory would never reach the
  /// owner it exists to warn, which is the whole point of keeping it.
  verifiedReleaseTag  String?                  @map("verified_release_tag")
  /// Set by the upstream release poll, cleared by the re-verification it
  /// provokes. Not nullable, unlike its neighbours: null and false would
  /// describe the same loadout, and the "never verified" state a read
  /// actually has to act on is already carried by a null `verifiedReleaseTag`.
  /// A third state here would only be one more thing for a caller to forget.
  needsReverification Boolean                  @default(false) @map("needs_reverification")
  description         String?
  sourceUrl           String?                  @map("source_url")
  category            String?
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([organizationId, visibility])
  @@map("private_artifact")
}

/// Path-addressed schema and prompt assets for one tool artifact.
///
/// A sibling of PrivateArtifactContent rather than a widening of it: content
/// is one row per kind, while assets are many rows per kind, addressed by the
/// path the extension manifest spells. `kind` is `schema` or `prompt`, which
/// are the two asset classes the agent bounds and matches independently
/// (ironhub/model.rs IronHubToolEntry.schemas / .prompts).
model PrivateArtifactAsset {
  id         String          @id
  artifactId String          @map("artifact_id")
  artifact   PrivateArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  kind       String
  path       String
  storageKey String          @map("storage_key")
  sha256     String
  sizeBytes  Int             @map("size_bytes")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([artifactId, kind, path])
  @@index([artifactId])
  @@map("private_artifact_asset")
}

model PrivateArtifactContent {
  id         String          @id
  artifactId String          @map("artifact_id")
  artifact   PrivateArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  kind       String
  storageKey String          @map("storage_key")
  sha256     String
  sizeBytes  Int             @map("size_bytes")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([artifactId, kind])
  @@index([artifactId])
  @@map("private_artifact_content")
}

/// One member of a loadout: a tool, skill, or soul the loadout installs
/// alongside its siblings.
///
/// Members are leaves. A loadout is never a member of another one -- the
/// composition service refuses it, and this table gives nesting no foothold:
/// a row is either a pointer at one leaf artifact in the same organization or
/// a public entry named by kind and name, and neither reaches another
/// loadout's membership.
///
/// `source` says where the member is read from, and with it what a digest
/// difference means. A `private` member is a row in this hub owned by the
/// loadout's own organization, and `artifactId` points at it. A `public`
/// member is a verified marketplace entry resolved live from upstream, so
/// there is no row to point at: `artifactId` stays null and `kind`, `name`
/// and `version` are the whole address. That is also why the reference is
/// optional -- the two sources are addressed differently, not one of them
/// half-recorded.
///
/// `version` and `pinnedDigest` are null until the loadout is published,
/// because publish is when they are taken. A draft records only which members
/// it holds; publishing resolves each one and writes down what it found. The
/// pin is a fingerprint rather than an address: no source retains a previous
/// version, so a member always resolves to whatever is currently published
/// under its identity, and the digest exists to say whether that is still
/// what was pinned. A private member is blocked on a mismatch; a public one
/// is only reported, since its release cadence is not the loadout owner's to
/// control.
model LoadoutMember {
  id           String           @id
  loadoutId    String           @map("loadout_id")
  loadout      PrivateArtifact  @relation("LoadoutMembers", fields: [loadoutId], references: [id], onDelete: Cascade)
  source       String
  kind         String
  name         String
  version      String?
  artifactId   String?          @map("artifact_id")
  /// Restrict where PrivateArtifactContent and PrivateArtifactAsset cascade,
  /// and the difference is the point. Those rows are parts of an artifact and
  /// are right to die with it. This one is a reference held by a *different*
  /// artifact, and cascading would empty a published loadout silently, from a
  /// screen that never mentioned it. The database refuses the delete instead,
  /// so removing a member is something its owner does deliberately after
  /// being told which loadout is holding it.
  ///
  /// The rule protects only the rows that carry the pointer, which is to say
  /// the private ones. A private member recorded without it would be
  /// unprotected by a table that looks like it protects everything, so the
  /// composition service sets `artifactId` on every private member rather
  /// than treating it as optional metadata.
  artifact     PrivateArtifact? @relation("LoadoutMemberArtifact", fields: [artifactId], references: [id], onDelete: Restrict)
  pinnedDigest String?          @map("pinned_digest")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([loadoutId, source, kind, name])
  @@index([loadoutId])
  @@index([artifactId])
  @@map("loadout_member")
}
