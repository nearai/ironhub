{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouTube get_transcript input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "video_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": ["video_id"]
}
