{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "list_pools input",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "description": "Exact chain filter, e.g. 'Ethereum'."
    },
    "project": {
      "type": "string",
      "description": "Project slug filter (substring), e.g. 'aave-v3', 'lido'."
    },
    "symbol": {
      "type": "string",
      "description": "Token symbol filter (substring), e.g. 'USDC'."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20,
      "description": "Max pools, sorted by TVL desc."
    }
  },
  "additionalProperties": false
}
