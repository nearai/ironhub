{
  "version": "0.1.0",
  "effects": [],
  "wit_version": "0.3.0",
  "description": "Messari crypto research and market data tool for Ironclaw. Access prices, market metrics, news, token unlocks, fundraising rounds, DeFi protocols, network stats, and Messari AI synthesis.",
  "capabilities": {
    "http": {
      "allowlist": [
        {
          "host": "api.messari.io",
          "path_prefix": "/",
          "methods": [
            "GET",
            "POST"
          ]
        }
      ],
      "credentials": {
        "messari_api_key": {
          "secret_name": "messari_api_key",
          "location": {
            "type": "header",
            "name": "x-messari-api-key"
          },
          "host_patterns": [
            "api.messari.io"
          ]
        }
      },
      "rate_limit": {
        "requests_per_minute": 150,
        "requests_per_hour": 3000
      },
      "timeout_secs": 30
    },
    "secrets": {
      "allowed_names": [
        "messari_api_key"
      ]
    }
  },
  "auth": {
    "secret_name": "messari_api_key",
    "display_name": "Messari API Key",
    "instructions": "Get your API key at https://messari.io/account/api, then paste it here. Please note: you need Pro/ Enterprise subscription for access most Messari features!",
    "setup_url": "https://messari.io/account/api",
    "token_hint": "Messari API Key",
    "env_var": "MESSARI_API_KEY"
  },
  "setup": {
    "required_secrets": [
      {
        "name": "messari_api_key",
        "prompt": "Messari API Key"
      }
    ]
  }
}
