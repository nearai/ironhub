{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "options_overview input",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "description": "Chain filter, e.g. 'ethereum'. Omit for all chains."
    },
    "data_type": {
      "type": "string",
      "enum": [
        "dailyPremiumVolume",
        "dailyNotionalVolume"
      ],
      "description": "Volume type (default dailyNotionalVolume)."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20,
      "description": "Max protocols, sorted by 24h volume desc."
    }
  },
  "additionalProperties": false
}
