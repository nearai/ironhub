{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "simple_price input",
  "type": "object",
  "properties": {
    "ids": {
      "type": "string",
      "description": "Comma-separated list of coin IDs (e.g. 'bitcoin,ethereum')."
    },
    "vs_currencies": {
      "type": "string",
      "description": "Comma-separated list of target currencies (e.g. 'usd,eur')."
    },
    "include_market_cap": {
      "type": "boolean",
      "description": "Include market cap. Default is false."
    },
    "include_24hr_vol": {
      "type": "boolean",
      "description": "Include 24hr volume. Default is false."
    },
    "include_24hr_change": {
      "type": "boolean",
      "description": "Include 24hr price change percentage. Default is false."
    },
    "include_last_updated_at": {
      "type": "boolean",
      "description": "Include last updated timestamp. Default is false."
    },
    "pro": {
      "type": "boolean",
      "description": "Set to true to use the Pro API domain. Default is false."
    }
  },
  "additionalProperties": false,
  "required": [
    "ids",
    "vs_currencies"
  ]
}
