{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordPress update resource input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site_url": { "type": "string", "minLength": 4, "maxLength": 253, "description": "The host pinned in manifest.toml, with or without https://." },
    "id": { "type": "integer", "minimum": 1 },
    "data": { "type": "object", "minProperties": 1, "description": "Provider-native fields to update." }
  },
  "required": ["site_url", "id", "data"]
}
