        "points": {
          "type": "integer",
          "minimum": 2,
          "maximum": 500,
          "default": 90,
          "description": "Max history points returned (evenly downsampled)."
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "stablecoin_chains"
