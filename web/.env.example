# Generate every secret with a strong random value. Never deploy the placeholders.
DATABASE_URL=postgres://user:password@localhost:5432/ironhub

# Session signing secret. generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The origin this hub serves on. Cosmetic for most of the app and
# correctness-critical for private installs: it becomes the private manifest
# URL and every artifact URL inside it, and the agent re-validates all of them
# against the catalog origin IT is configured with. It must therefore be the
# same origin, exactly, as the agent's `IRONHUB_MANIFEST_URL`, and it must be
# an https URL whose host is not an IP address, not `localhost`, not
# dotless, and not on an internal suffix (`.local`, `.internal`, `.lan`,
# `.corp`, `.private`, `.intranet`, `.home`) -- the agent rejects all of those
# outright. Anything building an agent-facing manifest fails with an error
# naming this setting rather than serving a manifest the agent will refuse.
#
# The value below is fine for local UI work and CANNOT be used to test an
# install against a real agent: the agent additionally requires its configured
# catalog URL to be `hub.ironclaw.com`, `github.com`, or `*.githubusercontent.com`,
# so no locally reachable host can pass. That is an upstream IronClaw issue
# (catalog-origin lock-in), tracked in lib/catalog/UPSTREAM-IRONCLAW.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISABLE_ACCOUNT_ROUTE=false
NEXT_PUBLIC_DISABLE_AGENTS_ROUTE=false
NEXT_PUBLIC_DISABLE_MVP_ROUTE=false
NEXT_PUBLIC_ENABLE_ILIAD=false
# "Install to Agent" cannot work today: no surface on the IronClaw agent
# consumes the deep link the hub emits. Leave unset/false until that lands
# upstream. See the comment on isAgentInstallEnabled in lib/shared/feature-flags.ts.
NEXT_PUBLIC_ENABLE_AGENT_INSTALL=false
TRUSTED_ORIGINS=http://localhost:3000

# At-rest encryption of agent shared keys. Must be at least 32 chars. generate: openssl rand -base64 32
IRONHUB_KEY_ENCRYPTION_SECRET=

# HMAC secret for private-artifact bearer tokens (required). generate: openssl rand -base64 32
IRONHUB_PRIVATE_ARTIFACT_TOKEN_SECRET=

# Ed25519 private key (base64-encoded PKCS8) used to sign the catalog manifest.
IRONHUB_MANIFEST_SIGNING_KEY=

# S3-compatible blob storage. Local dev stack values (docker compose up at repo root):
# endpoint http://localhost:8334, accessKey ironhub, secretKey ironhub-local-secret, bucket ironhub
S3_ENDPOINT=
# Endpoint reachable from the browser for presigned URLs (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ILIAD_BASE_URL=
ILIAD_X_API_KEY=

# Origin IronClaw is configured with (its IRONHUB_MANIFEST_URL). Every artifact
# URL published in the catalog must sit on this exact origin or the agent
# refuses the install: it pins artifact URLs to the catalog origin (scheme,
# host, port). Defaults to https://hub.ironclaw.com when unset.
HUB_PUBLIC_BASE_URL=

# DEVELOPMENT ONLY. Lets NEXT_PUBLIC_APP_URL and a registered agent URL use
# http and a loopback/dotless host, so an agent running on this machine can be
# driven end-to-end without a public tunnel. Ignored entirely when
# NODE_ENV=production, and only the exact string "true" enables it. Never set
# this on a deployed hub. See web/lib/shared/local-origins.ts.
IRONHUB_ALLOW_LOCAL_ORIGINS=
