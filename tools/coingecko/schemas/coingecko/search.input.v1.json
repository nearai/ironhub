{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search input",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "Search query keyword."
    },
    "pro": {
      "type": "boolean",
