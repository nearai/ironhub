        "action"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "stablecoin_prices"
        },
        "points": {
          "type": "integer",
          "minimum": 2,
          "maximum": 500,
          "default": 90,
          "description": "Max daily price points returned."
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "properties": {
        "action": {
          "const": "list_pools"
        },
