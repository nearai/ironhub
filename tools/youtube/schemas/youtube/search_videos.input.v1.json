{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouTube search_videos input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": { "type": "string", "minLength": 1, "maxLength": 500 },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 50 },
    "order": {
      "type": "string",
      "enum": ["date", "rating", "relevance", "title", "videoCount", "viewCount"]
    },
    "type_filter": { "type": "string", "enum": ["video", "channel", "playlist"] },
    "published_after": { "type": "string", "format": "date-time" },
    "page_token": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "required": ["query"]
}
