{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IrmAction",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "list_incidents"
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "default": 20,
          "minimum": 0
        },
        "order_direction": {
          "$ref": "#/$defs/OrderDirection"
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "get_incident"
        },
        "incident_id": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "incident_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "get_timeline"
        },
        "activity_kind": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "incident_id": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "default": 20,
          "minimum": 0
        },
        "order_direction": {
          "$ref": "#/$defs/OrderDirection"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "incident_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "list_fields"
        }
      },
      "required": [
        "action"
      ]
    }
  ],
  "$defs": {
    "OrderDirection": {
      "type": "string",
      "enum": [
        "ascending",
        "descending"
      ]
    }
  }
}
