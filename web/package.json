{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test:catalog": "node --experimental-strip-types --test \"lib/catalog/*.test.mjs\"",
    "test:discovery": "node --experimental-strip-types --test \"lib/discovery/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "signing:check": "node scripts/check-manifest-signing.mjs && node scripts/check-install-payload-signing.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "auth:generate": "pnpm dlx auth@latest generate --config lib/auth/server.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tabler/icons-react": "^3.46.0",
    "better-auth": "1.6.28",
    "better-near-auth": "1.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.4.2",
    "ipaddr.js": "^2.5.0",
    "js-yaml": ">=4.2.0 <6",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "7.9.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  }
}
